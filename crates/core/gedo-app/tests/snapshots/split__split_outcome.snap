--- src/lib.rs
pub struct Invoice {
    pub amount: u32,
}

impl Invoice {
    pub fn total(&self) -> u32 {
        self.amount
    }
}

pub fn report(invoice: &Invoice) -> u32 {
    invoice.total() + 2
}

pub fn discount() -> u32 {
    1
}

pub fn audit(invoice: &Invoice) -> u32 {
    invoice.total()
}
